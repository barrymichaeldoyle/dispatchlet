# Convex (from `npx convex dev`). The .convex.site URL is always derived from VITE_CONVEX_URL.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# PostHog (optional locally; production's are committed in .env.production)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Browser tests: the signed-in tests need the same value set on the dev deployment
# (npx convex env set E2E_AUTH_SECRET …). 32 characters or more.
E2E_AUTH_SECRET=

# Set on the Convex deployment, not here (README, "Run it yourself", lists them all):
#   BUFFER_CLIENT_ID, BUFFER_CLIENT_SECRET, SITE_URL, JWT_PRIVATE_KEY, JWKS, TOKEN_ENC_KEY,
#   ANTHROPIC_API_KEY, RESEND_API_KEY, ALLOWED_EMAILS or ALLOWED_BUFFER_IDS (or SIGNUP_OPEN=true)
#   ALERT_EMAIL and ALERTS_SECRET (POST /alerts/errors refuses every call without the secret)
