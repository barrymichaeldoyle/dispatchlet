# Convex (from `npx convex dev`)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
# Optional. Defaults to VITE_CONVEX_URL with .convex.cloud swapped for .convex.site
VITE_CONVEX_SITE_URL=

# PostHog (optional locally)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Set on the Convex deployment, not here:
#   RESEND_API_KEY, SITE_URL
#   ALERTS_SECRET (POST /alerts/errors refuses every call without it, then needs it in X-Alerts-Secret)
