# Convex (from `npx convex dev`)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
# Optional. Defaults to VITE_CONVEX_URL with .convex.cloud swapped for .convex.site
VITE_CONVEX_SITE_URL=

# PostHog (optional locally)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Set on the Convex deployment, not here:
#   RESEND_API_KEY, SITE_URL, IP_HASH_SALT
#   WAITLIST_RATE_LIMIT (optional, default 5 per IP per hour; raised on dev for e2e)
