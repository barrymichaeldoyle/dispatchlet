{
  "name": "dispatchlet",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3131",
    "build": "vite build",
    "build:deploy": "convex deploy --cmd 'pnpm build' --cmd-url-env-var-name VITE_CONVEX_URL",
    "preview": "vite preview",
    "deploy": "pnpm build:deploy && wrangler deploy",
    "generate-routes": "tsr generate",
    "og": "node scripts/og/render.mjs",
    "lint": "oxlint --max-warnings 0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm knip && pnpm test",
    "e2e": "playwright test",
    "prepare": "husky",
    "audit": "pnpm audit --audit-level low",
    "precommit": "pnpm exec lint-staged --quiet && pnpm --silent run typecheck && pnpm --silent exec vitest run --silent"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@auth/core": "^0.41.3",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@convex-dev/auth": "0.0.96",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sentry/browser": "^11.11.0",
    "@sentry/cloudflare": "^11.11.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "convex": "^1.49.0",
    "posthog-js": "^1.447.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.65.0",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/router-cli": "^1.167.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.2.1",
    "convex-test": "^0.0.67",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "oxlint",
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,json5,md,mdx,yaml,yml,html,css,scss}": "oxfmt --check"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.17.0"
}
