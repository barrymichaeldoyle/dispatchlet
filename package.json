{
  "name": "dispatchlet",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3131",
    "build": "vite build",
    "build:deploy": "convex deploy --cmd 'pnpm build' --cmd-url-env-var-name VITE_CONVEX_URL",
    "preview": "vite preview",
    "deploy": "pnpm build:deploy && wrangler deploy",
    "generate-routes": "tsr generate",
    "og": "node scripts/og/render.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm knip && pnpm test",
    "e2e": "playwright test",
    "prepare": "husky",
    "audit": "pnpm audit --audit-level low",
    "precommit": "pnpm exec lint-staged && pnpm run audit && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@auth/core": "^0.41.3",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@convex-dev/auth": "0.0.96",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.2",
    "convex": "^1.32.0",
    "posthog-js": "^1.358.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "convex-test": "^0.0.62",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.70.0"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "oxlint",
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,json5,md,mdx,yaml,yml,html,css,scss}": "oxfmt --check"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0"
}
